{
  "name": "@splitpea/server",
  "version": "0.0.0",
  "private": true,
  "main": "src/index.ts",
  "scripts": {
    "dev": "prisma generate --schema prisma/schema.sqlite.prisma && tsx watch src/index.ts",
    "start": "prisma generate --schema prisma/schema.sqlite.prisma && tsx src/index.ts",
    "start:prod": "prisma generate --schema prisma/schema.prisma && tsx src/index.ts",
    "postinstall": "prisma generate --schema prisma/schema.sqlite.prisma",
    "db:push": "prisma db push --schema prisma/schema.sqlite.prisma",
    "db:push:prod": "prisma db push --schema prisma/schema.prisma --skip-generate",
    "db:reset": "prisma db push --schema prisma/schema.sqlite.prisma --force-reset --skip-generate",
    "db:generate": "prisma generate --schema prisma/schema.sqlite.prisma",
    "db:generate:prod": "prisma generate --schema prisma/schema.prisma",
    "db:studio": "prisma studio --schema prisma/schema.sqlite.prisma",
    "test:security": "node --import tsx --test test/http-security.test.ts",
    "test:retention": "node --import tsx --test test/retention.test.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.19.0",
    "@splitpea/core": "*",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.6.1",
    "prisma": "^5.19.0",
    "tsx": "^4.19.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.5.0"
  }
}
