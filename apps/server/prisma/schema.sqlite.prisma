// SplitPea local-development schema. Production uses schema.prisma (Postgres).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Group {
  id         String    @id @default(cuid())
  name       String
  type       String    @default("split")
  inviteCode String    @unique
  createdAt  DateTime  @default(now())
  lastActivityAt DateTime @default(now())
  members    Member[]
  accounts   Account[]
  expenses   Expense[]
  messages   Message[]
  payments   Payment[]
}

model Member {
  id        String    @id @default(cuid())
  groupId   String
  name      String
  removedAt DateTime?
  group     Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)

  messages     Message[]
  splits       Split[]
  expensesPaid Expense[] @relation("ExpensePaidByMember")
  accountsPaid Account[] @relation("AccountPaidByMember")
}

model Account {
  id             String  @id @default(cuid())
  groupId        String
  name           String
  paidByMemberId String?
  group          Group   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  paidByMember   Member? @relation("AccountPaidByMember", fields: [paidByMemberId], references: [id])

  expensesPaid Expense[] @relation("ExpensePaidByAccount")
}

model Expense {
  id          String   @id @default(cuid())
  groupId     String
  amount      Float
  description String
  category    String?
  date        DateTime @default(now())
  createdVia  String   @default("manual")
  createdAt   DateTime @default(now())
  archivedAt  DateTime?

  paidByMemberId  String?
  paidByAccountId String?

  group         Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  paidByMember  Member?  @relation("ExpensePaidByMember", fields: [paidByMemberId], references: [id])
  paidByAccount Account? @relation("ExpensePaidByAccount", fields: [paidByAccountId], references: [id])
  splits        Split[]
}

model Split {
  id        String  @id @default(cuid())
  expenseId String
  memberId  String
  mode      String  @default("even")
  value     Float   @default(0)
  expense   Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  member    Member  @relation(fields: [memberId], references: [id])
}

model Payment {
  id           String   @id @default(cuid())
  groupId      String
  fromMemberId String
  toMemberId   String?
  amount       Float
  date         DateTime?
  statementFrom DateTime?
  statementTo   DateTime?
  createdAt    DateTime @default(now())
  group        Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
}

model Message {
  id          String   @id @default(cuid())
  groupId     String
  memberId    String?
  role        String
  text        String
  cardType    String?
  cardPayload String?
  createdAt   DateTime @default(now())
  group       Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  member      Member?  @relation(fields: [memberId], references: [id])
}
