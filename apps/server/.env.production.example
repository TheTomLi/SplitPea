# Neon pooled connection string used by the running API.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Neon direct connection string used by Prisma schema deployment.
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

NODE_ENV="production"
TRUST_PROXY="1"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-flash-latest"

CORS_ALLOWED_ORIGINS="https://getsplitpea.com,https://www.getsplitpea.com"
CORS_ALLOWED_ORIGIN_SUFFIXES=".splitpea.pages.dev"

# Optional overrides. Defaults are suitable for a one-instance soft launch.
RATE_LIMIT_WINDOW_MS="900000"
RATE_LIMIT_MAX_MUTATIONS="180"
MESSAGE_RATE_LIMIT_MAX="40"
GROUP_RATE_LIMIT_MAX="20"
