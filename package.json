{
  "name": "spliitai",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "server": "npm run dev --workspace @spliitai/server",
    "app": "npm run web --workspace @spliitai/app",
    "db:push": "npm run db:push --workspace @spliitai/server",
    "db:reset": "npm run db:reset --workspace @spliitai/server"
  },
  "devDependencies": {
    "typescript": "^5.5.4"
  }
}
